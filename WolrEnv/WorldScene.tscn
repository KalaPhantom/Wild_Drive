[sub_resource type="GDScript" id="GDScript_gan6u"]
script/source = "extends CanvasLayer


@export var car: VehicleBody3D
@export var idle_time_to_show := 4.0
@export var move_speed_threshold := 0.5
@export var fade_time := 0.5

# Utilized the Vbox container as opposed to using panel
# Panel always shows a background that overlays with the screen
@onready var Vbox = $VBoxContainer
var _idle := 0.0
var _visible := true 
var _tween: Tween

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	Vbox.modulate.a = 22

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if _is_player_moving():
		_idle = 0.0
		if visible:
			set_menu(false)
	else:
		_idle += delta
		if _idle >= idle_time_to_show and not _visible:
			set_menu(true)
			

func _is_player_moving() -> bool:
	var pressing := Input.is_action_just_pressed(\"W\") or Input.is_action_just_pressed(\"A\") or Input.is_action_just_pressed(\"S\") or Input.is_action_just_pressed(\"D\")
	var rolling := car != null and car.linear_velocity.length() > move_speed_threshold
	return pressing or rolling
	

# Sets the visibility of the frames 
func set_menu(show: bool) -> void:
	_visible = show
	if _tween:
		_tween.kill()
	_tween = create_tween()
	_tween.tween_property(Vbox, \"modulate:a\", 1.0 if show else 0.0, fade_time)
"

