[sub_resource type="GDScript" id="GDScript_7t07g"]
script/source = "extends Area3D


@export var boost_multi := 7.0
@export var duration := 30

# Time it woul need to reactiveate the effect
@export var reuse_time := 10


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	body_entered.connect(_on_body_entered)
	

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
	

# Detects the Body 3D upon enters
func _on_body_entered(body: Node3D) -> void:
	if body.has_method(\"apply_boost\"):
		body.apply_boost(boost_multi, duration)
		_collect()

# For collecting the powerup in the Area 3D
func _collect():
	if reuse_time <= 0:
		queue_free()
		return
	hide()
	set_deferred(\"monitoring\", false)
	await get_tree().create_timer(reuse_time).timeout
	show()
	monitoring = true
"

