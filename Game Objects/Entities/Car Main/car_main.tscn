[sub_resource type="GDScript" id="GDScript_abomu"]
script/source = "extends VehicleBody3D

# Values for the steering and acceleration
@export var steer = 0.5
@export var power = 100
@export var power_multi = 3       # Can be used as a basic power multiplier
var base_power_multi = 1 

# Timer -- New Instance
# TODO: Make the instance on the inference time 
var timer: Timer

@onready var cam1 = $TopMainCam
@onready var cam2 = $SideCamera
@onready var cam3 = $\"Upper Camera\"
@onready var cam4 = $UpperBackCamera

# The active camera by default is the cam 1 
# Range of 0-2 - for each camera represents index
@export var activeCam := 0


#-- For Resetting the Position of the Object Node
@export var z_lift := 1.5			# The amount of z axis for translation
var lift_requested := false         # Boolean value for flag

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	cam2.make_current()       # Makes the camera as the current camera
	timer = Timer.new()
	timer.one_shot = true
	timer.timeout.connect(end_boost)
	add_child(timer)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _physics_process(delta: float) -> void:
	steering = move_toward(steering, Input.get_axis(\"D\", \"A\") * steer, delta * 10)
	engine_force = Input.get_axis(\"S\", \"W\")  * (power * power_multi * base_power_multi)
	print(engine_force)

# Apply boost function
# Detected through the Area 2d and invoked separately2
func apply_boost(powerMulti: float, duration: float):
	base_power_multi = powerMulti * base_power_multi
	timer.start(duration)

func end_boost():
	base_power_multi = 1

func _input(event: InputEvent) -> void:
	if Input.is_action_just_pressed(\"ChangeCam\"):
		match activeCam:
			0:
				activeCam += 1 
				cam2.make_current()
			1:
				activeCam += 1
				cam4.make_current()
			2:
				activeCam += 1 
				cam3.make_current()
			3: 
				activeCam = 0
				cam1.make_current()
	
#	 Condition B - When the reset button was pressed
	if Input.is_action_just_pressed(\"reset_car_pos\"):
		if _is_tipped_over():
			lift_requested = true
	

# Flip Logic Detector
# TODO: Add a coordinate map logic, that allows the vehicle to be spawned randomly in the map
func _is_tipped_over() -> bool:
	return global_transform.basis.y.dot(Vector3.UP) < 0.6

func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	
	# Filters out the unnecessary request per frame
	if not lift_requested:
		return
	
	lift_requested = false
	
	# Transform Values
	var t := state.transform
	var forward := -t.basis.z
	
	forward.y = 0.0
	
	if forward.length() < 0.1: 
		forward = t.basis.y
		forward.y = 0.0
	forward = forward.normalized() 
	
	t.basis = Basis.looking_at(forward, Vector3.UP)
	t.origin.y += z_lift
	state.transform = t
	state.linear_velocity = Vector3.ZERO
	state.angular_velocity = Vector3.ZERO
	
"

